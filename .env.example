# Public client configuration. Keep third-party provider secrets server-side.
EXPO_PUBLIC_SUPABASE_URL=
# Preferred current client key from the Supabase Connect panel.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects can use this during migration.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Public web origin used in share links, for example https://bojio.example.com.
EXPO_PUBLIC_APP_URL=
